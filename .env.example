# Root environment variables (development defaults)
# Copy this file to .env and adjust values as needed per service.

# ===== Database (Neon PostgreSQL - cloud) =====
# DukaStock connects to a Neon PostgreSQL database. The backend reads this
# value from server/.env (development) or server/.env.production (production);
# customise it in YOUR local `.env` file — never commit real credentials.
#
# Use the Neon "pooled" connection string for application runtime and Prisma:
#   postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true
#
# Use the Neon "direct" (non-pooler) connection string for one-off operations
# such as `prisma migrate deploy` or `pg_dump`/`pg_restore`:
#   postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15"

# ===== Test database =====
# Tests reset the database schema and wipe all rows, so they must run against
# a DEDICATED disposable test database (a Neon test branch or a throwaway local
# PostgreSQL). NEVER point test operations at a database that holds real data.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/test_db?sslmode=require&pgbouncer=true"

# ===== Production database =====
# For PRODUCTION use `server/.env.production` (gitignored) with the same Neon
# connection string, and set DATABASE_URL as a secret in your deployment
# platform. Never put production credentials in this example file, source code,
# or git.

# ===== Server =====
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ===== Authentication / sessions =====
# Generate strong random secrets, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-session-secret"
COOKIE_SECRET="change-me-cookie-secret"

# ===== Cookie configuration =====
# COOKIE_SECURE=true in production (HTTPS only)
COOKIE_SECURE=false

# ===== Cloudinary (product & storefront images) =====
# Add these on the SERVER to enable server-side Cloudinary image uploads. The
# API secret is never exposed to the browser. Obtain your own credentials from
# https://cloudinary.com and never commit real secrets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Redis (cache / queues / locks / rate limiting / offline sync) =====
# Redis is an INFRASTRUCTURE component: it serves fast reads and coordination,
# but PostgreSQL remains the single source of truth for all business data.
# Set REDIS_ENABLED=false to run without Redis (all Redis features fail-open to
# the database and caches simply no-op).
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED="true"
# Redact/scope keys so caches for multiple environments/tenants never collide.
# REDIS_KEY_PREFIX="dukastock"

# Connection tuning
# REDIS_MAX_RETRIES=2
# REDIS_CONNECT_TIMEOUT=5000
# REDIS_COMMAND_TIMEOUT=2000
# REDIS_FAIL_OPEN="true"
# REDIS_TLS="false"

# ===== Production (optional, added when services are used) =====
# FRONTEND_URL=your-production-frontend-url

# ===== Future services (do not use in MVP) =====
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# WHATSAPP_API_TOKEN=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
